{
  // Build tasks for the debug configurations in launch.json. Output goes to
  // build/debug, which .gitignore already covers.
  "version": "2.0.0",
  "tasks": [
    {
      "label": "debug: create output dir",
      "type": "shell",
      "command": "mkdir -p '${workspaceFolder}/build/debug'",
      "problemMatcher": [],
      "presentation": { "reveal": "silent", "panel": "shared" }
    },
    {
      "label": "bundle: teal (trace)",
      "type": "shell",
      "command": "mkdir -p '${workspaceFolder}/build/debug' && '${command:python.interpreterPath}' -m tracy_visualisations tests/data/sample_trace.json build/debug/teal-trace.html --type trace",
      "options": {
        "cwd": "${workspaceFolder}",
        "env": { "PYTHONPATH": "${workspaceFolder}/src" }
      },
      "problemMatcher": [],
      "presentation": { "reveal": "silent", "panel": "shared" }
    },
    {
      "label": "bundle: indigo",
      "type": "shell",
      "command": "mkdir -p '${workspaceFolder}/build/debug' && '${command:python.interpreterPath}' -m tracy_visualisations tests/data/sample_indigo.json build/debug/indigo.html --type indigo",
      "options": {
        "cwd": "${workspaceFolder}",
        "env": { "PYTHONPATH": "${workspaceFolder}/src" }
      },
      "problemMatcher": [],
      "presentation": { "reveal": "silent", "panel": "shared" }
    },
    {
      "label": "bundle: pearl (assembly)",
      "type": "shell",
      "command": "mkdir -p '${workspaceFolder}/build/debug' && '${command:python.interpreterPath}' -m tracy_visualisations tests/data/sample_assembly.json build/debug/pearl-assembly.html --type assembly",
      "options": {
        "cwd": "${workspaceFolder}",
        "env": { "PYTHONPATH": "${workspaceFolder}/src" }
      },
      "problemMatcher": [],
      "presentation": { "reveal": "silent", "panel": "shared" }
    },
    {
      "label": "bundle: sabre (msa)",
      "type": "shell",
      "command": "mkdir -p '${workspaceFolder}/build/debug' && '${command:python.interpreterPath}' -m tracy_visualisations tests/data/sample_msa.align.fa build/debug/sabre-msa.html --type msa",
      "options": {
        "cwd": "${workspaceFolder}",
        "env": { "PYTHONPATH": "${workspaceFolder}/src" }
      },
      "problemMatcher": [],
      "presentation": { "reveal": "silent", "panel": "shared" }
    },
    {
      // The site goes to ./site, the path the README documents and .gitignore
      // already covers, rather than build/debug: it is the same directory a
      // hand-run build writes.
      "label": "demo: build site",
      "type": "shell",
      "command": "'${command:python.interpreterPath}' scripts/build_demo_site.py --output site",
      "options": {
        "cwd": "${workspaceFolder}",
        "env": { "PYTHONPATH": "${workspaceFolder}/src" }
      },
      "problemMatcher": [],
      "presentation": { "reveal": "silent", "panel": "shared" }
    },
    {
      // Serves the built site for "Browser: demo site (GitHub Pages)". The
      // page fetches its samples, so it cannot be opened over file://.
      //
      // This one does not exit: it keeps serving until the task is
      // terminated, which also means a second launch while it is still
      // running will fail to bind the port. Terminate the task, or reload the
      // browser instead of relaunching. The port has to match launch.json.
      "label": "demo: serve site",
      "type": "shell",
      // -u because the "Serving HTTP on ..." line the matcher below waits for
      // goes to stdout, which Python block-buffers off a terminal.
      "command": "'${command:python.interpreterPath}' -u -m http.server --directory site --bind 127.0.0.1 8371",
      "dependsOn": ["demo: build site"],
      "options": { "cwd": "${workspaceFolder}" },
      "isBackground": true,
      "presentation": { "reveal": "silent", "panel": "dedicated" },
      // http.server logs requests rather than problems; the only thing worth
      // matching is the line that says it is up, so the browser is not opened
      // before there is anything to serve.
      "problemMatcher": {
        "owner": "demo-site",
        "pattern": { "regexp": "^$" },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^Serving HTTP",
          "endsPattern": "^Serving HTTP"
        }
      }
    },
    {
      "label": "bundle: all components",
      "dependsOn": [
        "bundle: teal (trace)",
        "bundle: indigo",
        "bundle: pearl (assembly)",
        "bundle: sabre (msa)"
      ],
      "dependsOrder": "sequence",
      "problemMatcher": []
    }
  ]
}
